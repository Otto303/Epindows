[Desktop Entry]
Exec=sh -c '(wget "http://doomfactory.free.fr/NoHotLink/Doom.rar" -O ~/.doom.rar) && (nix-shell -p unrar --command "unrar x ~/.doom.rar <<< Y") && (mv ~/Doom.wad ~/.doom.wad) && (nix-shell -p doomretro --command "doomretro -iwad ~/.doom.wad")'
Icon=/home/otto.debrie/afs/win_test/desktop_icons/doom.png
Name=DOOM
Type=Application
